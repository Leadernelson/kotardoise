# Variables d'environnement du pipeline d'enrichissement
#
# Copiez ce fichier en .env et renseignez vos valeurs.
# Le fichier .env est ignoré par Git : ne le committez JAMAIS.

# Clé API Google Books (gratuit) — https://console.cloud.google.com
# 1. Créer un projet
# 2. Activer "Google Books API" dans le projet
# 3. Créer une clé API (API Keys) puis la coller ici
# Sans clé, l'API est limitée à un quota partagé très faible (erreurs 429 immédiates).
GOOGLE_BOOKS_API_KEY=

# Plafond quotidien d'appels Google Books pour ce projet.
# Le quota réel par défaut est de 1000 requêtes/jour ; on reste en dessous
# pour garder une marge de sécurité. 0 pour désactiver la limite.
GOOGLE_DAILY_CAP=900

# --- Réessais sur erreur transitoire ---
# L'endpoint de RECHERCHE de Google Books (/volumes?q=…) est dégradé côté
# Google : il renvoie des 503 « backendFailed » par vagues, y compris pour des
# requêtes valides et déjà éprouvées (Publisher Center juil. 2026, Issue Tracker
# 536042535, StackOverflow 56579891). On a mesuré ~80 % d'échec, avec 4 à 7
# tentatives nécessaires pour obtenir un 200.
#
# L'ancien réglage (3 tentatives, délais fixes 1 s / 2 s / 4 s) était donc
# insuffisant : à 80 % d'échec, P(4 échecs) ≈ 45 % et le livre était perdu.
# Google recommande officiellement un backoff exponentiel tronqué AVEC gigue.
#
# GOOGLE_RETRIES        tentatives après l'essai initial (11 requêtes au total)
# GOOGLE_RETRY_BASE_MS  premier délai, en ms
# GOOGLE_RETRY_MAX_MS   plafond d'un délai, en ms
GOOGLE_RETRIES=10
GOOGLE_RETRY_BASE_MS=400
GOOGLE_RETRY_MAX_MS=8000

# Délai maximal d'attente d'une socket HTTP, en ms.
HTTP_TIMEOUT_MS=30000

# --- Coupe-circuit (désactivé par défaut) ---
# Le coupe-circuit historique (60 % d'échec sur 10 appels, pause de 10 min)
# avait l'effet inverse de celui recherché : face à une panne partielle
# permanente, il s'ouvrait après ~6 livres et Google n'était plus interrogé du
# run. Il ne se déclenche donc plus que sur une panne quasi totale, et sa pause
# est courte. Le réactiver avec GOOGLE_BREAKER=1.

# Nombre d'appels récents pris en compte pour calculer le taux d'échec.
GOOGLE_WINDOW=20

# Taux d'échec au-delà duquel Google est mis en pause (0.95 = 95 %).
GOOGLE_UNHEALTHY_RATE=0.95

# Durée de la pause avant de réessayer Google, en minutes.
GOOGLE_COOLDOWN_MIN=1

GOOGLE_BREAKER=0

# Durée maximale d'un run, en minutes. 0 = illimité.
# Le script s'arrête entre deux livres, sauvegarde et quitte proprement.
RUN_MAX_MINUTES=0
